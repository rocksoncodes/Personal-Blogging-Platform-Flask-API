// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApiKey {
  id        String   @id @default(uuid())
  keyId     String   @unique
  hashedKey String
  createdAt DateTime @default(now())
}

